# Copia este archivo a ".env" (sin ".example") y completa los valores reales.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore) porque contiene
# credenciales secretas.

# URL del proyecto Supabase. La encuentras en: Project Settings > API > Project URL.
SUPABASE_URL=https://kjooqjcvztssgnrswdeg.supabase.co

# Clave "service_role" de Supabase (NO la "anon"/"publishable"). La encuentras en:
# Project Settings > API > Project API keys > service_role.
# Esta clave da acceso total a la base de datos saltándose los permisos, por eso
# el servidor la usa solo internamente y nunca se envía al navegador del cliente.
SUPABASE_SERVICE_KEY=

# Clave "anon"/"publishable" de Supabase (sí es segura de exponer al navegador,
# está diseñada para eso). Project Settings > API > Project API keys > anon.
SUPABASE_ANON_KEY=sb_publishable_7hlII2tRJgPna9sW_bqJOg_6cHHF5L6

# Puerto donde corre el servidor (opcional, por defecto 3000).
PORT=3000

# ---- Notificaciones por correo (opcional) ----
# Correo de Google Workspace/Gmail usado para enviar los avisos de reservas
# nuevas y aceptadas/rechazadas. Si se dejan vacíos, el sitio sigue
# funcionando normalmente, simplemente no manda esos correos.
SMTP_USER=

# Contraseña de APLICACIÓN de Google (16 caracteres, se genera en
# myaccount.google.com > Seguridad > Verificación en 2 pasos > Contraseñas de
# aplicaciones). NUNCA la contraseña normal de la cuenta.
SMTP_PASSWORD=

# Opcionales, por defecto usan Gmail/Workspace por TLS implícito.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=Vistas Quillayquen
